# ---- Public (safe to expose to the browser) --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Leave empty until a domain is purchased; the deployment URL is used instead.
NEXT_PUBLIC_SITE_URL=
# Optional Cloudflare Turnstile spam protection (both keys required to enable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ---------------------
# Used only on the server for: inviting/removing admin users, reading
# notification settings, and the one-off media seeding script.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (32+ chars) used to hash visitor IPs for rate limiting.
INQUIRY_HASH_SALT=change-me-to-a-long-random-string
TURNSTILE_SECRET_KEY=
# Optional e-mail notifications for new inquiries (https://resend.com)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=RUKN Website <notifications@your-domain.com>

# --- AI tools (optional) -------------------------------------------------
# Claude API key from https://console.anthropic.com (Settings → API keys).
# Enables the dashboard AI assistant and automatic reading of transfer receipts.
ANTHROPIC_API_KEY=
# Optional: model (default claude-sonnet-5-5) and questions per user per day (default 150)
AI_MODEL=
AI_DAILY_LIMIT=
